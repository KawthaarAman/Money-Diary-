<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/budget-category.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="category-form-page">

            <div class="category-form-card">

                <div class="category-form-icon">✎</div>

                <h1>Edit Category</h1>

                <p class="category-description">
                    Update your category and allocated amount.
                </p>

                <form action="/budget-category/<%= category._id %>?_method=PUT" method="POST">

                    <div class="form-group">
                        <label for="name">Category Name</label>

                        <input type="text" id="name" name="name" value="<%= category.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="allocatedAmount">Allocated Amount</label>

                        <input type="number" id="allocatedAmount" name="allocatedAmount"
                            value="<%= category.allocatedAmount %>" min="0" step="0.01" required>
                    </div>

                    <div class="category-form-actions">

                        <button type="submit" class="btn">
                            Save Changes
                        </button>

                        <a href="/budget-category/budget/<%= budget._id %>" class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </main>

</body>

</html>