
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <main class="category-container">
        <div class="category-card">

            <h1>Edit Category </h1>
            <p>Update your category details.</p>

            <form
                action="/budget-category/<%= category._id %>?_method=PUT"
                method="POST"
            >

                <label for="name">Category Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= category.name %>"
                    required
                >

                <label for="allocatedAmount">Allocated Amount</label>
                <input
                    type="number"
                    id="allocatedAmount"
                    name="allocatedAmount"
                    min="0"
                    step="0.001"
                    value="<%= category.allocatedAmount %>"
                    required
                >

                <button type="submit">Save Changes</button>

                <a class="cancel-btn"
                   href="/budget-category/budget/<%= budget._id %>">
                    Cancel
                </a>

            </form>

        </div>
    </main>

</body>
</html>
