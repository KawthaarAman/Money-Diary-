<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Categories | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/budget-category.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="container category-list-page">

            <div class="page-header">
                <div>
                    <h1>Budget Categories</h1>
                    <p>Organize your money into different spending categories.</p>
                </div>

                <a href="/budget-category/budget/<%= budget._id %>/new" class="btn">
                    + Add Category
                </a>
            </div>

            <% if (categories.length===0) { %>

                <div class="category-empty-card">
                    <div class="category-empty-icon">🗂️</div>

                    <h2>No Categories Yet</h2>

                    <p>
                        Start organizing your budget by adding your first category.
                    </p>

                    <a href="/budget-category/budget/<%= budget._id %>/new" class="btn">
                        Add Your First Category
                    </a>
                </div>

                <% } else { %>

                    <div class="category-summary-card">
                        <span>Total Allocated Budget</span>

                        <h2>
                            <%= totalAllocated.toFixed(2) %>
                        </h2>

                        <p>
                            <%= categories.length %> categories created
                        </p>
                    </div>

                    <div class="category-grid">

                        <% categories.forEach(category=> { %>

                            <div class="category-card">

                                <div class="category-card-icon">🌿</div>

                                <h3>
                                    <%= category.name %>
                                </h3>

                                <p class="category-amount">
                                    <%= Number(category.allocatedAmount).toFixed(2) %>
                                </p>

                                <span class="category-label">
                                    Allocated Amount
                                </span>

                                <div class="category-card-actions">

                                    <a href="/budget-category/<%= category._id %>/edit" class="btn btn-secondary">
                                        Edit
                                    </a>

                                    <form action="/budget-category/<%= category._id %>?_method=DELETE" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this category?');">
                                        <button type="submit" class="btn btn-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

                        <div class="category-back">
                            <a href="/budget/<%= budget._id %>" class="btn btn-secondary">
                                Back to Budget
                            </a>
                        </div>

        </main>

</body>

</html>