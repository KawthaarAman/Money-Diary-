<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Budgets | Money Diary</title>
</head>

<body>

    <%- include('../partials/navbar') %>

        <h1>My Budgets</h1>

        <% if (budgets.length===0) { %>

            <p>You haven't created any budgets yet.</p>
            <a href="/budget/new">Create your first budget</a>

            <% } else { %>

                <% budgets.forEach(budgets=> { %>

                    <div>
                        <h2>
                            <%= new Date(budgets.year, budgets.month - 1).toLocaleString('en-US', { month: 'long' }) %>
                                <%= budgets.year %>
                        </h2>

                        <form action="/budget/<%= budgets._id %>" method="GET">
                            <button type="submit">View Budget</button>
                        </form>

                        <br>

                        <form action="/budget/<%= budgets._id %>/edit" method="GET">
                            <button type="submit">Edit</button>
                        </form>

                        <br>

                        <form action="/budget/<%= budgets._id %>?_method=DELETE" method="POST">
                            <button type="submit">Delete</button>
                        </form>
                    </div>

                    <hr>

                    <% }) %>

                        <% } %>

</body>

</html>