<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Budgets | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/budget.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <div class="container">

            <div class="page-header">
                <h1>My Budgets</h1>
                <p>Manage and organize your monthly budgets.</p>
            </div>

            <div class="card-grid">

                <% budgets.forEach(budget=> { %>

                    <div class="card budget-card">

                        <div class="budget-card-header">
                            <span class="budget-label">MONTHLY BUDGET</span>

                            <h2>
                                <%= new Date(budget.year, budget.month - 1) .toLocaleString('en-US', { month: 'long' })
                                    %>
                            </h2>

                            <p>
                                <%= budget.year %>
                            </p>
                        </div>

                        <div class="card-actions">

                            <a href="/budget/<%= budget._id %>" class="btn">
                                View Budget
                            </a>

                            <a href="/budget/<%= budget._id %>/edit" class="btn btn-secondary">
                                Edit
                            </a>

                            <form action="/budget/<%= budget._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this budget?')">

                                <button type="submit" class="btn-danger">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                    <% }) %>

            </div>

            <% if (budgets.length===0) { %>
                <div class="card empty-budget">
                    <h2>No Budgets Yet</h2>
                    <p>Start planning your finances by creating your first budget.</p>

                    <a href="/budget/new" class="btn">
                        Create Your First Budget
                    </a>
                </div>
                <% } %>

        </div>

</body>

</html>