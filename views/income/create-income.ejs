<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Income | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/income.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="income-form-page">

            <div class="income-form-card">

                <div class="income-form-icon">＋</div>

                <h1>Add New Income</h1>

                <p class="income-form-description">
                    Record your salary or any additional income.
                </p>

                <form action="/income/budget/<%= budget._id %>" method="POST">

                    <div class="form-group">
                        <label for="source">Income Source</label>

                        <input type="text" id="source" name="source" placeholder="e.g. Salary, Freelance, Bonus"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="amount">Amount</label>

                        <input type="number" id="amount" name="amount" placeholder="Enter amount" min="0" step="0.01"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="date">Date</label>

                        <input type="date" id="date" name="date" required>
                    </div>

                    <div class="income-form-actions">

                        <button type="submit" class="btn">
                            Add Income
                        </button>

                        <a href="/income/budget/<%= budget._id %>" class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </main>

</body>

</html>