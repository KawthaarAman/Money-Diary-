<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Income | Money Diary</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar') %>

        <h1>Edit Income</h1>

        <form action="/income/<%= income._id %>?_method=PUT" method="POST">

            <label for="source">Income Source:</label>
            <input type="text" name="source" id="source" value="<%= income.source %>" required>

            <br><br>

            <label for="amount">Amount (BHD):</label>
            <input type="number" name="amount" id="amount" min="0.001" step="0.001" value="<%= income.amount %>"
                required>

            <br><br>

            <label for="date">Date:</label>
            <input type="date" name="date" id="date" value="<%= new Date(income.date).toISOString().slice(0, 10) %>"
                required>

            <br><br>

            <button type="submit">Save Changes</button>

            <button type="button" onclick="window.location.href='/income/budget/<%= budget._id %>'">
                Cancel
            </button>

        </form>

</body>

</html>