<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Income | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/income.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="container income-list-page">

            <div class="page-header">
                <div>
                    <h1>My Income</h1>
                    <p>All your income sources for this budget.</p>
                </div>
                <a href="/income/budget/<%= budget._id %>/new" class="btn">
                    + Add Income
                </a>
            </div>

            <% if (incomes.length===0) { %>

                <div class="income-empty-card">
                    <div class="income-empty-icon">💰</div>
                    <h2>No Income Yet</h2>
                    <p>Start by adding your salary or another income source.</p>

                    <a href="/income/budget/<%= budget._id %>/new" class="btn">
                        Add Your First Income
                    </a>
                </div>

                <% } else { %>

                    <div class="income-summary-card">
                        <span>Total Income</span>

                        <h2>
                            <%= incomes.reduce((total, income)=> total + income.amount, 0).toFixed(2) %>
                        </h2>
                    </div>

                    <div class="income-grid">

                        <% incomes.forEach(income=> { %>

                            <div class="income-card">

                                <div class="income-card-top">
                                    <div class="income-card-icon">💵</div>

                                    <span class="income-date">
                                        <%= new Date(income.date).toLocaleDateString() %>
                                    </span>
                                </div>

                                <h3>
                                    <%= income.source %>
                                </h3>

                                <p class="income-amount">
                                    <%= Number(income.amount).toFixed(2) %>
                                </p>

                                <div class="income-card-actions">

                                    <a href="/income/<%= income._id %>/edit" class="btn btn-secondary">
                                        Edit
                                    </a>

                                    <form action="/income/<%= income._id %>?_method=DELETE" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this income?');">
                                        <button type="submit" class="btn btn-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

                        <div class="income-back">
                            <a href="/budget/<%= budget._id %>" class="btn btn-secondary">
                                Back to Budget
                            </a>
                        </div>

        </main>

</body>

</html>