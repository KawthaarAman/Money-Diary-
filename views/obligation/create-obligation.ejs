<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Obligation | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/obligation.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="obligation-form-page">

            <div class="obligation-form-card">

                <div class="obligation-form-icon">📋</div>

                <h1>Add New Obligation</h1>

                <p class="obligation-description">
                    Keep track of your monthly payments and commitments.
                </p>

                <form action="/obligation/budget/<%= budget._id %>" method="POST">

                    <div class="form-group">
                        <label for="name">Obligation Name</label>
                        <input type="text" id="name" name="name" placeholder="e.g. Car Installment, Phone Bill"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="amount">Amount</label>
                        <input type="number" id="amount" name="amount" placeholder="Enter amount" min="0" step="0.01"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="dueDate">Due Date</label>
                        <input type="date" id="dueDate" name="dueDate" required>
                    </div>

                    <div class="obligation-form-actions">
                        <button type="submit" class="btn">
                            Add Obligation
                        </button>

                        <a href="/obligation/budget/<%= budget._id %>" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>

        </main>

</body>

</html>