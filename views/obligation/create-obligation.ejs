
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Obligation</title>
    <link rel="stylesheet" href="/css/obligation.css">
</head>
<body>

    <main class="obligation-container">
        <div class="obligation-card">
            <h1>Add an Obligation </h1>
            <p>Add a monthly payment or financial commitment.</p>

            <form action="/obligation/budget/<%= budget._id %>" method="POST">

                <label for="name">Obligation Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="e.g. Car installment"
                    required
                >

                <label for="amount">Amount</label>
                <input
                    type="number"
                    id="amount"
                    name="amount"
                    min="0.001"
                    step="0.001"
                    placeholder="0.000"
                    required
                >

                <label for="dueDate">Due Date</label>
                <input
                    type="date"
                    id="dueDate"
                    name="dueDate"
                    required
                >

                <button type="submit">Add Obligation </button>

                <a class="cancel-btn" href="/obligation/budget/<%= budget._id %>">
                    Cancel
                </a>

            </form>
        </div>
    </main>

</body>
</html>
