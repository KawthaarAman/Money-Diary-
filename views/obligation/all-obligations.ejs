<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Obligations | Money Diary</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/obligation.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="container obligation-list-page">

            <div class="page-header">
                <div>
                    <h1>My Obligations</h1>
                    <p>Keep an eye on your monthly payments.</p>
                </div>

                <a href="/obligation/budget/<%= budget._id %>/new" class="btn">
                    + Add Obligation
                </a>
            </div>

            <% if (obligations.length===0) { %>

                <div class="obligation-empty-card">
                    <div class="obligation-empty-icon">📋</div>
                    <h2>No Obligations Yet</h2>
                    <p>You haven't added any monthly payments.</p>

                    <a href="/obligation/budget/<%= budget._id %>/new" class="btn">
                        Add Your First Obligation
                    </a>
                </div>

                <% } else { %>

                    <div class="obligation-summary-grid">

                        <div class="obligation-summary-card">
                            <span>Total Obligations</span>
                            <h2>
                                <%= obligations.reduce((total, item)=> total + item.amount, 0).toFixed(2) %>
                            </h2>
                        </div>

                        <div class="obligation-summary-card">
                            <span>Paid</span>
                            <h2>
                                <%= obligations.filter(item=> item.isPaid).length %>
                            </h2>
                        </div>

                        <div class="obligation-summary-card">
                            <span>Unpaid</span>
                            <h2>
                                <%= obligations.filter(item=> !item.isPaid).length %>
                            </h2>
                        </div>

                    </div>

                    <div class="obligation-grid">

                        <% obligations.forEach(obligation=> { %>

                            <div class="obligation-card">

                                <div class="obligation-card-top">
                                    <div class="obligation-card-icon">📌</div>

                                    <span class="obligation-status <%= obligation.isPaid ? 'paid' : 'unpaid' %>">
                                        <%= obligation.isPaid ? 'Paid' : 'Unpaid' %>
                                    </span>
                                </div>

                                <h3>
                                    <%= obligation.name %>
                                </h3>

                                <p class="obligation-amount">
                                    <%= Number(obligation.amount).toFixed(2) %>
                                </p>

                                <p class="obligation-due-date">
                                    Due:
                                    <%= new Date(obligation.dueDate).toLocaleDateString() %>
                                </p>

                                <div class="obligation-card-actions">

                                    <a href="/obligation/<%= obligation._id %>/edit" class="btn btn-secondary">
                                        Edit
                                    </a>

                                    <form action="/obligation/<%= obligation._id %>?_method=DELETE" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this obligation?');">
                                        <button type="submit" class="btn btn-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>

                                <form action="/obligation/<%= obligation._id %>/status?_method=PUT" method="POST">
                                    <button type="submit" class="obligation-status-button">
                                        Mark as <%= obligation.isPaid ? 'Unpaid' : 'Paid' %>
                                    </button>
                                </form>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

                        <div class="obligation-back">
                            <a href="/budget/<%= budget._id %>" class="btn btn-secondary">
                                Back to Budget
                            </a>
                        </div>

        </main>

</body>

</html>