<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Obligations</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="obligation-container">

        <div class="page-header">
            <h1>My Obligations</h1>

            <a class="add-btn" href="/obligation/budget/<%= budget._id %>/new">
                + Add Obligation
            </a>
        </div>

        <p>
            Your financial commitments for
            <%= new Date(budget.year, budget.month - 1) .toLocaleString("en-US", { month: "long" }) %>
                <%= budget.year %>
        </p>

        <% if (obligations.length===0) { %>

            <div class="empty-state">
                <h2>No obligations yet </h2>
                <p>Add your monthly payments to keep track of them.</p>
            </div>

            <% } else { %>

                <div class="obligation-list">

                    <% let totalObligations=0; %>
                        <% let paidTotal=0; %>

                            <% obligations.forEach(obligation=> { %>

                                <% totalObligations +=obligation.amount; %>

                                    <% if (obligation.isPaid) { %>
                                        <% paidTotal +=obligation.amount; %>
                                            <% } %>

                                                <div class="obligation-item">

                                                    <div class="obligation-info">
                                                        <h3>
                                                            <%= obligation.name %>
                                                        </h3>

                                                        <p>
                                                            Amount:
                                                            <%= obligation.amount.toFixed(3) %>
                                                        </p>

                                                        <p>
                                                            Due date:
                                                            <%= new Date(obligation.dueDate) .toLocaleDateString() %>
                                                        </p>

                                                        <span class="<%= obligation.isPaid ? 'paid' : 'unpaid' %>">
                                                            <%= obligation.isPaid ? 'Paid ✓' : 'Unpaid' %>
                                                        </span>
                                                    </div>

                                                    <div class="action-buttons">

                                                        <form
                                                            action="/obligation/<%= obligation._id %>/status?_method=PUT"
                                                            method="POST">
                                                            <button type="submit" class="status-btn">
                                                                <%= obligation.isPaid ? 'Mark Unpaid' : 'Mark Paid' %>
                                                            </button>
                                                        </form>

                                                        <a class="edit-btn"
                                                            href="/obligation/<%= obligation._id %>/edit">
                                                            Edit
                                                        </a>

                                                        <form action="/obligation/<%= obligation._id %>?_method=DELETE"
                                                            method="POST"
                                                            onsubmit="return confirm('Delete this obligation?')">
                                                            <button type="submit" class="delete-btn">
                                                                Delete
                                                            </button>
                                                        </form>

                                                    </div>

                                                </div>

                                                <% }) %>

                                                    <div class="obligation-summary">
                                                        <p>
                                                            Total obligations:
                                                            <strong>
                                                                <%= totalObligations.toFixed(3) %>
                                                            </strong>
                                                        </p>

                                                        <p>
                                                            Paid:
                                                            <strong>
                                                                <%= paidTotal.toFixed(3) %>
                                                            </strong>
                                                        </p>

                                                        <p>
                                                            Remaining unpaid:
                                                            <strong>
                                                                <%= (totalObligations - paidTotal).toFixed(3) %>
                                                            </strong>
                                                        </p>
                                                    </div>

                </div>

                <% } %>

                    <a class="back-btn" href="/budget/<%= budget._id %>">
                        ← Back to Budget
                    </a>

    </main>

</body>

</html>