<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Obligation | Money Diary</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/obligation.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="obligation-form-page">

            <div class="obligation-form-card">

                <div class="obligation-form-icon">✎</div>

                <h1>Edit Obligation</h1>

                <p class="obligation-description">
                    Update your payment details below.
                </p>

                <form action="/obligation/<%= obligation._id %>?_method=PUT" method="POST">

                    <div class="form-group">
                        <label for="name">Obligation Name</label>
                        <input type="text" id="name" name="name" value="<%= obligation.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="amount">Amount</label>
                        <input type="number" id="amount" name="amount" value="<%= obligation.amount %>" min="0"
                            step="0.01" required>
                    </div>

                    <div class="form-group">
                        <label for="dueDate">Due Date</label>
                        <input type="date" id="dueDate" name="dueDate"
                            value="<%= new Date(obligation.dueDate).toISOString().split('T')[0] %>" required>
                    </div>

                    <div class="form-group">
                        <label for="isPaid">Payment Status</label>

                        <select id="isPaid" name="isPaid">
                            <option value="false" <%=obligation.isPaid ? '' : 'selected' %>>
                                Unpaid
                            </option>

                            <option value="true" <%=obligation.isPaid ? 'selected' : '' %>>
                                Paid
                            </option>
                        </select>
                    </div>

                    <div class="obligation-form-actions">
                        <button type="submit" class="btn">
                            Save Changes
                        </button>

                        <a href="/obligation/budget/<%= budget._id %>" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>

        </main>

</body>

</html>