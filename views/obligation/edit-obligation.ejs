
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Obligation</title>
    <link rel="stylesheet" href="/css/obligation.css">
</head>
<body>

    <main class="obligation-container">
        <div class="obligation-card">

            <h1>Edit Obligation </h1>
            <p>Update your financial commitment.</p>

            <form
                action="/obligation/<%= obligation._id %>?_method=PUT"
                method="POST"
            >

                <label for="name">Obligation Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= obligation.name %>"
                    required
                >

                <label for="amount">Amount</label>
                <input
                    type="number"
                    id="amount"
                    name="amount"
                    min="0.001"
                    step="0.001"
                    value="<%= obligation.amount %>"
                    required
                >

                <label for="dueDate">Due Date</label>
                <input
                    type="date"
                    id="dueDate"
                    name="dueDate"
                    value="<%= new Date(obligation.dueDate).toISOString().slice(0, 10) %>"
                    required
                >

                <button type="submit">Save Changes</button>

                <a class="cancel-btn" href="/obligation/budget/<%= budget._id %>">
                    Cancel
                </a>

            </form>

        </div>
    </main>

</body>
</html>
