<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Savings Goals | Money Diary</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/savings-goal.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="goals-container">

            <div class="goals-header">

                <div>
                    <h1>My Savings Goals</h1>
                    <p>Small steps lead to big dreams.</p>
                </div>

                <a href="/savings-goal/budget/<%= budget._id %>/new" class="btn btn-primary">
                    + Add New Goal
                </a>

            </div>

            <% if (savingsGoals.length> 0) { %>

                <div class="goals-grid">

                    <% savingsGoals.forEach(goal=> { %>

                        <% const percentage=goal.targetAmount> 0
                            ? Math.min((goal.savedAmount / goal.targetAmount) * 100, 100)
                            : 0; %>

                            <div class="goal-card">

                                <% if (goal.photo) { %>
                                    <img src="<%= goal.photo %>" alt="<%= goal.name %>" class="goal-photo">
                                    <% } else { %>
                                        <div class="goal-photo-placeholder">
                                            <span>♡</span>
                                        </div>
                                        <% } %>

                                            <div class="goal-card-header">

                                                <h2>
                                                    <%= goal.name %>
                                                </h2>

                                                <% if (goal.savedAmount>= goal.targetAmount) { %>
                                                    <span class="goal-status completed">Completed</span>
                                                    <% } else { %>
                                                        <span class="goal-status in-progress">In Progress</span>
                                                        <% } %>

                                            </div>

                                            <div class="goal-amounts">

                                                <div>
                                                    <span>Saved</span>
                                                    <strong>
                                                        <%= goal.savedAmount.toFixed(2) %>
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>Target</span>
                                                    <strong>
                                                        <%= goal.targetAmount.toFixed(2) %>
                                                    </strong>
                                                </div>

                                            </div>

                                            <div class="progress-section">

                                                <div class="progress-info">
                                                    <span>Progress</span>
                                                    <strong>
                                                        <%= percentage.toFixed(0) %>%
                                                    </strong>
                                                </div>

                                                <div class="progress-bar">
                                                    <div class="progress-fill" style="width: <%= percentage %>%"></div>
                                                </div>

                                            </div>

                                            <div class="goal-deadline">

                                                <span>Deadline</span>

                                                <strong>
                                                    <%= goal.deadline ? new Date(goal.deadline).toLocaleDateString()
                                                        : "No deadline set" %>
                                                </strong>

                                            </div>

                                            <div class="goal-actions">

                                                <a href="/savings-goal/<%= goal._id %>/edit" class="btn btn-secondary">
                                                    Edit
                                                </a>

                                                <form action="/savings-goal/<%= goal._id %>?_method=DELETE"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this goal?')">

                                                    <button type="submit" class="btn btn-danger">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                            </div>

                            <% }) %>

                </div>

                <% } else { %>

                    <div class="empty-goals">

                        <h2>No savings goals yet!</h2>

                        <p>Start planning your next dream by creating your first savings goal.</p>

                        <a href="/savings-goal/budget/<%= budget._id %>/new" class="btn btn-primary">
                            Create Your First Goal
                        </a>

                    </div>

                    <% } %>

                        <div class="back-button">
                            <a href="/budget/<%= budget._id %>" class="btn btn-secondary">
                                Back to Budget
                            </a>
                        </div>

        </main>

</body>

</html>