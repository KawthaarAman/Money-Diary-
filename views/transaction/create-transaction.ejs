<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Transaction | Money Diary</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/transaction.css">
</head>

<body>

    <%- include('../partials/navbar.ejs') %>

        <main class="transaction-container">

            <div class="transaction-header">
                <p class="eyebrow">MONEY DIARY</p>
                <h1>Add a Transaction</h1>
                <p>Keep track of where your money goes.</p>
            </div>

            <section class="transaction-form-card">

                <form action="/transaction/budget/<%= budget._id %>" method="POST" enctype="multipart/form-data">

                    <div class="form-group">
                        <label for="title">Transaction Name</label>
                        <input type="text" id="title" name="title" placeholder="e.g. Coffee, Groceries, Shopping"
                            required>
                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label for="amount">Amount</label>
                            <input type="number" id="amount" name="amount" placeholder="0.000" min="0" step="0.001"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="date">Date</label>
                            <input type="date" id="date" name="date"
                                value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>

                    </div>

                    <div class="form-group">
                        <label for="categoryId">Budget Category</label>

                        <select id="categoryId" name="categoryId" required>
                            <option value="">Select a category</option>

                            <% categories.forEach(category=> { %>
                                <option value="<%= category._id %>">
                                    <%= category.name %>
                                </option>
                                <% }) %>
                        </select>

                        <% if (categories.length===0) { %>
                            <p class="form-hint">
                                You need to create a budget category before adding a transaction.
                            </p>
                            <% } %>
                    </div>

                    <!-- Photo Upload -->

                    <div class="form-group">
                        <label for="photo">Upload Photo (Optional)</label>

                        <input type="file" id="photo" name="photo" accept="image/*">

                        <small class="form-hint">
                            Upload a photo of your purchase. Maximum size: 5 MB.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="mood">How did you feel about this purchase?</label>

                        <select id="mood" name="mood">
                            <option value="">Choose your mood</option>
                            <option value="Happy">😊 Happy</option>
                            <option value="Satisfied">😌 Satisfied</option>
                            <option value="Neutral">😐 Neutral</option>
                            <option value="Regretful">😔 Regretful</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="note">Note (Optional)</label>
                        <textarea id="note" name="note" rows="4"
                            placeholder="Write something about this purchase..."></textarea>
                    </div>

                    <div class="form-buttons">

                        <button type="submit" class="btn btn-primary" <%=categories.length===0 ? "disabled" : "" %>
                            >
                            Save Transaction
                        </button>

                        <a href="/transaction/budget/<%= budget._id %>" class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </section>

        </main>

</body>

</html>